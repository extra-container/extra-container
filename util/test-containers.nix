# A representative container definition used by `just evalWith <nixpkgs>` and CI to check
# that ./eval-config.nix still evaluates against a given nixpkgs. It touches the features
# that have broken in the past (reduced module set, extra.* options, networking) without
# needing root or a build. Add anything here that should be covered by compatibility checks.
{ pkgs, lib, ... }:
{
  # Host-side service tweaks must merge with the container@ units generated by nixos-containers.
  systemd.services."container@test-priv" = {
    wants = [ "network-online.target" ];
    after = [ "network-online.target" ];
  };

  containers.test-priv = {
    extra = {
      addressPrefix = "10.250.100";
      enableWAN = true;
      firewallAllowHost = true;
      exposeLocalhost = true;
    };
    autoStart = true;
    bindMounts."/data" = {
      hostPath = "/var/empty";
      isReadOnly = true;
    };
    config =
      { pkgs, ... }:
      {
        networking.firewall.allowedTCPPorts = [ 8080 ];
        services.openssh.enable = true;
        users.users.user = {
          isNormalUser = true;
          uid = 1000;
          group = "users";
        };
        environment.etc."test".text = "ok";
        environment.systemPackages = [ pkgs.curl ];
        systemd.services.hello = {
          wantedBy = [ "multi-user.target" ];
          script = "echo hello";
        };
      };
  };

  containers.test-netns = {
    privateNetwork = false;
    networkNamespace = "/run/netns/test";
    config = {
      networking.useDHCP = false;
      networking.firewall.enable = false;
    };
  };

  containers.test-plain = {
    config = { };
  };
}
